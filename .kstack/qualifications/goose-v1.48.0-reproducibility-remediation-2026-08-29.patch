diff --git a/vendor/deno_core/modules/module_map_data.rs b/vendor/deno_core/modules/module_map_data.rs
index 32e8553..2f1aa53 100644
--- a/vendor/deno_core/modules/module_map_data.rs
+++ b/vendor/deno_core/modules/module_map_data.rs
@@ -16,6 +16,28 @@ use crate::runtime::SnapshotLoadDataStore;
 use crate::runtime::SnapshotStoreDataStore;
 use serde::Deserialize;
 use serde::Serialize;
+
+fn compare_requested_module_types(
+  left: &RequestedModuleType,
+  right: &RequestedModuleType,
+) -> std::cmp::Ordering {
+  fn rank(value: &RequestedModuleType) -> u8 {
+    match value {
+      RequestedModuleType::None => 0,
+      RequestedModuleType::Json => 1,
+      RequestedModuleType::Text => 2,
+      RequestedModuleType::Bytes => 3,
+      RequestedModuleType::Other(_) => 4,
+    }
+  }
+
+  rank(left).cmp(&rank(right)).then_with(|| match (left, right) {
+    (RequestedModuleType::Other(left), RequestedModuleType::Other(right)) => {
+      left.as_ref().cmp(right.as_ref())
+    }
+    _ => std::cmp::Ordering::Equal,
+  })
+}
 use std::cell::RefCell;
 use std::collections::HashMap;
 use std::rc::Rc;
@@ -377,6 +399,14 @@ impl ModuleMapData {
     self.by_name.drain(|_, module_type, name, module| {
       ser.by_name.push((name, module_type.clone(), module));
     });
+    ser.by_name.sort_by(
+      |(left_name, left_type, _), (right_name, right_type, _)| {
+        left_name
+          .as_str()
+          .cmp(right_name.as_str())
+          .then_with(|| compare_requested_module_types(left_type, right_type))
+      },
+    );
 
     ser
   }
