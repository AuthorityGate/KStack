{
  "description": "KStack bounded safety policy for Codex: user and project evaluators; no host allow decisions.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/kstack-safety-hook.mjs\" --scope user",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\kstack-safety-hook.mjs\" --scope user",
            "timeout": 2,
            "statusMessage": "Checking KStack user safety policy"
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/kstack-safety-hook.mjs\" --scope project",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\kstack-safety-hook.mjs\" --scope project",
            "timeout": 2,
            "statusMessage": "Checking KStack project safety policy"
          }
        ]
      }
    ]
  }
}
